@startuml C4_L1_Contexto
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title Nivel 1 - Contexto del Sistema de Gestión Odontológica

Person(admin, "Administrador", "Configura usuarios, sedes, prácticas y coberturas. Audita y gestiona backups. Sin acceso clínico.")
Person(dentist, "Odontólogo", "Registra historia clínica, odontograma, archivos y prestaciones.")
Person(recep, "Recepcionista", "Gestiona pacientes, agenda, confirmaciones y cobros. Sin acceso clínico.")

System(sgo, "Sistema de Gestión Odontológica", "Aplicación web para la gestión integral del consultorio. Opera en la LAN de la organización.")

System_Ext(backupDest, "Destino de backups", "Disco o NAS separado del almacenamiento principal")
System_Ext(mp, "Mercado Pago", "Stretch: sandbox de cobros")
System_Ext(arca, "ARCA", "Stretch: facturación electrónica en homologación")

Rel(admin, sgo, "Administra y audita", "HTTPS")
Rel(dentist, sgo, "Registra la atención clínica", "HTTPS")
Rel(recep, sgo, "Gestiona pacientes, turnos y cobros", "HTTPS")
Rel(sgo, backupDest, "Escribe y restaura backups")
Rel(sgo, mp, "Consulta pagos (opcional)", "HTTPS")
Rel(sgo, arca, "Emite comprobantes (opcional)", "HTTPS")
@enduml
