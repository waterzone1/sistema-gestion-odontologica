generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id               String   @id @default(uuid(7)) @db.Uuid
  name             String
  timezone         String   @default("America/Argentina/Buenos_Aires")
  active           Boolean  @default(true)
  coveragesEnabled Boolean  @default(false)
  settings         Json     @default("{}")
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  branches          Branch[]
  users             User[]
  patients          Patient[]
  practices         Practice[]
  appointments      Appointment[]
  exchangeRates     ExchangeRate[]
  coverageProviders CoverageProvider[]
  liquidations      Liquidation[]
  reminders         Reminder[]
}

model Branch {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  address        String?
  phone          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization           Organization            @relation(fields: [organizationId], references: [id])
  users                  UserBranch[]
  appointments           Appointment[]
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]

  @@index([organizationId])
}

enum Role {
  ADMIN
  DENTIST
  RECEPTIONIST
}

model User {
  id                  String          @id @default(uuid(7)) @db.Uuid
  organizationId      String          @db.Uuid
  username            String
  displayName         String
  passwordHash        String
  active              Boolean         @default(true)
  mustChangePassword  Boolean         @default(false)
  onboardingCompleted Boolean         @default(false)
  theme               ThemePreference @default(SYSTEM)
  preferences         Json            @default("{}")
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(3)

  organization        Organization         @relation(fields: [organizationId], references: [id])
  roles               UserRole[]
  branches            UserBranch[]
  sessions            Session[]
  professionalProfile ProfessionalProfile?
  createdAppointments Appointment[]
  payments            Payment[]            @relation("PaymentCreatedBy")
  creditApplications  CreditApplication[]  @relation("CreditApplicationCreatedBy")
  patientNotes        PatientNote[]        @relation("PatientNoteAuthor")
  exchangeRates       ExchangeRate[]
  liquidations        Liquidation[]

  @@unique([organizationId, username])
  @@index([organizationId])
}

model UserRole {
  userId String @db.Uuid
  role   Role

  user User @relation(fields: [userId], references: [id])

  @@id([userId, role])
}

model UserBranch {
  userId   String @db.Uuid
  branchId String @db.Uuid

  user   User   @relation(fields: [userId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@id([userId, branchId])
  @@index([branchId])
}

model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  tokenHash  String    @unique
  userId     String    @db.Uuid
  csrfToken  String
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  ipAddress  String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model ProfessionalProfile {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @unique @db.Uuid
  licenseNumber String
  color         String?
  phone         String?
  email         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  user                   User                    @relation(fields: [userId], references: [id])
  appointments           Appointment[]
  clinicalEntries        ClinicalEntry[]
  services               PerformedService[]
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  practices              ProfessionalPractice[]
  clinicalProfiles       ClinicalProfile[]
  clinicalFiles          ClinicalFile[]
  toothFindings          ToothFinding[]
  treatmentPlans         TreatmentPlan[]
}

model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String?  @db.Uuid
  actorUserId    String?  @db.Uuid
  action         String
  entityType     String
  entityId       String?
  branchId       String?  @db.Uuid
  metadata       Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([organizationId, createdAt])
  @@index([actorUserId])
  @@index([entityType, entityId])
}

enum DocumentType {
  DNI
  LE
  LC
  PASAPORTE
  OTRO
}

model Patient {
  id               String       @id @default(uuid(7)) @db.Uuid
  organizationId   String       @db.Uuid
  firstName        String
  lastName         String
  documentType     DocumentType @default(DNI)
  documentNumber   String?
  birthDate        DateTime?    @db.Date
  phone            String?
  phoneHasWhatsapp Boolean      @default(true)
  email            String?
  address          String?
  searchText       String
  archivedAt       DateTime?    @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)

  organization       Organization        @relation(fields: [organizationId], references: [id])
  appointments       Appointment[]
  clinicalEntries    ClinicalEntry[]
  services           PerformedService[]
  payments           Payment[]
  creditApplications CreditApplication[]
  clinicalProfiles   ClinicalProfile[]
  clinicalFiles      ClinicalFile[]
  toothFindings      ToothFinding[]
  treatmentPlans     TreatmentPlan[]
  notes              PatientNote[]
  coverages          PatientCoverage[]
  reminders          Reminder[]

  @@unique([organizationId, documentType, documentNumber])
  @@index([organizationId, archivedAt])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "Patient_searchText_trgm_idx")
}

model Practice {
  id                     String   @id @default(uuid(7)) @db.Uuid
  organizationId         String   @db.Uuid
  code                   String
  name                   String
  defaultDurationMinutes Int      @default(30)
  basePrice              Decimal  @db.Decimal(14, 2)
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @db.Timestamptz(3)

  organization   Organization           @relation(fields: [organizationId], references: [id])
  appointments   Appointment[]
  services       PerformedService[]
  professionals  ProfessionalPractice[]
  treatmentItems TreatmentItem[]
  agreementItems AgreementItem[]

  @@unique([organizationId, code])
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  ATTENDED
  NO_SHOW
  CANCELLED
}

model Appointment {
  id                 String            @id @default(uuid(7)) @db.Uuid
  organizationId     String            @db.Uuid
  branchId           String            @db.Uuid
  patientId          String            @db.Uuid
  professionalId     String            @db.Uuid
  practiceId         String?           @db.Uuid
  startsAt           DateTime          @db.Timestamptz(3)
  endsAt             DateTime          @db.Timestamptz(3)
  status             AppointmentStatus @default(SCHEDULED)
  notes              String?
  cancellationReason String?
  createdById        String            @db.Uuid
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)

  availabilityOverride Boolean @default(false)
  overrideReason       String?

  closureKind            AppointmentClosureKind?
  closureReason          String?
  closureTreatmentItemId String?                 @db.Uuid
  closedAt               DateTime?               @db.Timestamptz(3)
  closedById             String?                 @db.Uuid

  organization    Organization        @relation(fields: [organizationId], references: [id])
  branch          Branch              @relation(fields: [branchId], references: [id])
  patient         Patient             @relation(fields: [patientId], references: [id])
  professional    ProfessionalProfile @relation(fields: [professionalId], references: [id])
  practice        Practice?           @relation(fields: [practiceId], references: [id])
  createdBy       User                @relation(fields: [createdById], references: [id])
  clinicalEntries ClinicalEntry[]
  services        PerformedService[]
  closureItem     TreatmentItem?      @relation(fields: [closureTreatmentItemId], references: [id], onDelete: Restrict)
  reminders       Reminder[]

  @@index([organizationId, startsAt])
  @@index([professionalId, startsAt])
  @@index([patientId, startsAt])
}

enum ClinicalEntryType {
  EVOLUTION
  CORRECTION
}

model ClinicalEntry {
  id             String            @id @default(uuid(7)) @db.Uuid
  patientId      String            @db.Uuid
  professionalId String            @db.Uuid
  appointmentId  String?           @db.Uuid
  entryType      ClinicalEntryType
  content        String
  correctionOfId String?           @db.Uuid
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)

  patient      Patient             @relation(fields: [patientId], references: [id])
  professional ProfessionalProfile @relation(fields: [professionalId], references: [id])
  appointment  Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  correctionOf ClinicalEntry?      @relation("Correction", fields: [correctionOfId], references: [id], onDelete: Restrict)
  corrections  ClinicalEntry[]     @relation("Correction")
  files        ClinicalFile[]

  @@index([patientId, createdAt])
  @@index([correctionOfId])
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  MERCADOPAGO
  OTHER
}

model PerformedService {
  id                String         @id @default(uuid(7)) @db.Uuid
  organizationId    String         @db.Uuid
  patientId         String         @db.Uuid
  professionalId    String         @db.Uuid
  practiceId        String         @db.Uuid
  appointmentId     String?        @db.Uuid
  treatmentItemId   String?        @db.Uuid
  tooth             Int?
  surfaces          ToothSurface[]
  price             Decimal        @db.Decimal(14, 2)
  catalogPrice      Decimal        @db.Decimal(14, 2)
  coverageAmount    Decimal        @default(0) @db.Decimal(14, 2)
  patientCoverageId String?        @db.Uuid
  authorizationCode String?
  performedAt       DateTime       @db.Timestamptz(3)
  createdById       String         @db.Uuid
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  voidedAt          DateTime?      @db.Timestamptz(3)
  voidReason        String?
  voidedById        String?        @db.Uuid

  patient          Patient             @relation(fields: [patientId], references: [id])
  professional     ProfessionalProfile @relation(fields: [professionalId], references: [id])
  practice         Practice            @relation(fields: [practiceId], references: [id])
  appointment      Appointment?        @relation(fields: [appointmentId], references: [id])
  allocations      PaymentAllocation[]
  treatmentItem    TreatmentItem?      @relation(fields: [treatmentItemId], references: [id], onDelete: Restrict)
  patientCoverage  PatientCoverage?    @relation(fields: [patientCoverageId], references: [id], onDelete: Restrict)
  liquidationItems LiquidationItem[]

  @@index([organizationId, patientId, performedAt])
  @@index([patientCoverageId, performedAt])
  @@index([organizationId, performedAt])
  @@index([appointmentId])
  @@index([treatmentItemId])
}

model Payment {
  id                String        @id @default(uuid(7)) @db.Uuid
  organizationId    String        @db.Uuid
  patientId         String        @db.Uuid
  amount            Decimal       @db.Decimal(14, 2)
  currency          Currency      @default(ARS)
  originalAmount    Decimal       @db.Decimal(14, 2)
  exchangeRate      Decimal       @default(1) @db.Decimal(12, 2)
  method            PaymentMethod
  externalReference String?
  receivedAt        DateTime      @db.Timestamptz(3)
  createdById       String        @db.Uuid
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  voidedAt          DateTime?     @db.Timestamptz(3)
  voidReason        String?
  voidedById        String?       @db.Uuid

  patient     Patient             @relation(fields: [patientId], references: [id])
  createdBy   User                @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  allocations PaymentAllocation[]

  @@index([organizationId, patientId, receivedAt])
  @@index([organizationId, receivedAt])
}

model PaymentAllocation {
  id                  String  @id @default(uuid(7)) @db.Uuid
  paymentId           String  @db.Uuid
  serviceId           String  @db.Uuid
  creditApplicationId String? @db.Uuid
  amount              Decimal @db.Decimal(14, 2)

  payment           Payment            @relation(fields: [paymentId], references: [id])
  service           PerformedService   @relation(fields: [serviceId], references: [id])
  creditApplication CreditApplication? @relation(fields: [creditApplicationId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([serviceId])
  @@index([creditApplicationId])
}

model CreditApplication {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  patientId      String    @db.Uuid
  amount         Decimal   @db.Decimal(14, 2)
  createdById    String    @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  voidedAt       DateTime? @db.Timestamptz(3)
  voidReason     String?
  voidedById     String?   @db.Uuid

  patient     Patient             @relation(fields: [patientId], references: [id])
  createdBy   User                @relation("CreditApplicationCreatedBy", fields: [createdById], references: [id])
  allocations PaymentAllocation[]

  @@index([organizationId, patientId, createdAt])
  @@index([organizationId, createdAt])
}

enum AvailabilityExceptionType {
  BLOCK
  VACATION
  ABSENCE
  EXTRA
}

model AvailabilityRule {
  id             String   @id @default(uuid(7)) @db.Uuid
  professionalId String   @db.Uuid
  branchId       String   @db.Uuid
  weekday        Int
  startMinute    Int
  endMinute      Int
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id])
  branch       Branch              @relation(fields: [branchId], references: [id])

  @@index([professionalId, weekday])
}

model AvailabilityException {
  id             String                    @id @default(uuid(7)) @db.Uuid
  professionalId String                    @db.Uuid
  branchId       String?                   @db.Uuid
  type           AvailabilityExceptionType
  startsAt       DateTime                  @db.Timestamptz(3)
  endsAt         DateTime                  @db.Timestamptz(3)
  reason         String
  createdById    String                    @db.Uuid
  createdAt      DateTime                  @default(now()) @db.Timestamptz(3)
  revokedAt      DateTime?                 @db.Timestamptz(3)
  revokedById    String?                   @db.Uuid

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id])
  branch       Branch?             @relation(fields: [branchId], references: [id])

  @@index([professionalId, startsAt])
}

model ProfessionalPractice {
  professionalId String @db.Uuid
  practiceId     String @db.Uuid

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id])
  practice     Practice            @relation(fields: [practiceId], references: [id])

  @@id([professionalId, practiceId])
}

enum ThemePreference {
  SYSTEM
  LIGHT
  DARK
}

enum ClinicalFileCategory {
  XRAY
  STUDY
  PHOTO
  CONSENT
  OTHER
}

model ClinicalProfile {
  id             String   @id @default(uuid(7)) @db.Uuid
  patientId      String   @db.Uuid
  professionalId String   @db.Uuid
  alerts         String?
  allergies      String?
  medications    String?
  background     String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  patient      Patient             @relation(fields: [patientId], references: [id])
  professional ProfessionalProfile @relation(fields: [professionalId], references: [id])

  @@index([patientId, createdAt])
}

model ClinicalFile {
  id              String               @id @default(uuid(7)) @db.Uuid
  patientId       String               @db.Uuid
  professionalId  String               @db.Uuid
  clinicalEntryId String?              @db.Uuid
  category        ClinicalFileCategory
  filename        String
  mimeType        String
  size            Int
  sha256          String
  storageKey      String               @unique
  description     String?
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  archivedAt      DateTime?            @db.Timestamptz(3)
  archivedById    String?              @db.Uuid

  patient       Patient             @relation(fields: [patientId], references: [id])
  professional  ProfessionalProfile @relation(fields: [professionalId], references: [id])
  clinicalEntry ClinicalEntry?      @relation(fields: [clinicalEntryId], references: [id], onDelete: Restrict)

  @@index([patientId, createdAt])
}

enum ToothSurface {
  M
  D
  V
  L
  O
}

enum ToothCondition {
  HEALTHY
  CARIES
  RESTORATION
  TEMP_RESTORATION
  CROWN
  ROOT_CANAL
  IMPLANT
  FRACTURE
  MISSING
  EXTRACTION_INDICATED
  SEALANT
  PROSTHESIS
}

model ToothFinding {
  id             String         @id @default(uuid(7)) @db.Uuid
  patientId      String         @db.Uuid
  professionalId String         @db.Uuid
  tooth          Int
  surface        ToothSurface?
  condition      ToothCondition
  note           String?
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  patient      Patient             @relation(fields: [patientId], references: [id])
  professional ProfessionalProfile @relation(fields: [professionalId], references: [id])

  @@index([patientId, tooth, createdAt])
}

enum TreatmentPlanStatus {
  DRAFT
  ACCEPTED
  COMPLETED
  CANCELLED
}

enum TreatmentItemStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model TreatmentPlan {
  id             String              @id @default(uuid(7)) @db.Uuid
  organizationId String              @db.Uuid
  patientId      String              @db.Uuid
  professionalId String              @db.Uuid
  title          String?
  status         TreatmentPlanStatus @default(DRAFT)
  acceptedAt     DateTime?           @db.Timestamptz(3)
  acceptedById   String?             @db.Uuid
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)

  patient      Patient             @relation(fields: [patientId], references: [id])
  professional ProfessionalProfile @relation(fields: [professionalId], references: [id])
  items        TreatmentItem[]

  @@index([organizationId, patientId, createdAt])
}

model TreatmentItem {
  id            String              @id @default(uuid(7)) @db.Uuid
  planId        String              @db.Uuid
  practiceId    String              @db.Uuid
  tooth         Int?
  surfaces      ToothSurface[]
  notes         String?
  agreedPrice   Decimal?            @db.Decimal(14, 2)
  status        TreatmentItemStatus @default(PLANNED)
  cancelReason  String?
  completedAt   DateTime?           @db.Timestamptz(3)
  completedById String?             @db.Uuid
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(3)

  plan            TreatmentPlan      @relation(fields: [planId], references: [id])
  practice        Practice           @relation(fields: [practiceId], references: [id])
  services        PerformedService[]
  sessionClosures Appointment[]

  @@index([planId])
}

model PatientNote {
  id           String    @id @default(uuid(7)) @db.Uuid
  patientId    String    @db.Uuid
  authorId     String    @db.Uuid
  content      String
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  archivedAt   DateTime? @db.Timestamptz(3)
  archivedById String?   @db.Uuid

  patient Patient @relation(fields: [patientId], references: [id])
  author  User    @relation("PatientNoteAuthor", fields: [authorId], references: [id])

  @@index([patientId, createdAt])
}

enum AppointmentClosureKind {
  TREATMENT_SESSION
  NO_CHARGE
}

enum Currency {
  ARS
  USD
}

model ExchangeRate {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  currency       Currency
  rate           Decimal  @db.Decimal(12, 2)
  setById        String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  setBy        User         @relation(fields: [setById], references: [id])

  @@index([organizationId, currency, createdAt])
}

enum CoverageKind {
  OBRA_SOCIAL
  PREPAGA
  OTHER
}

model CoverageProvider {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  kind           CoverageKind
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id])
  plans        CoveragePlan[]
  liquidations Liquidation[]

  @@unique([organizationId, name])
}

model CoveragePlan {
  id         String   @id @default(uuid(7)) @db.Uuid
  providerId String   @db.Uuid
  name       String
  code       String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  provider         CoverageProvider  @relation(fields: [providerId], references: [id])
  patientCoverages PatientCoverage[]
  agreements       Agreement[]

  @@unique([providerId, name])
}

model PatientCoverage {
  id              String    @id @default(uuid(7)) @db.Uuid
  patientId       String    @db.Uuid
  planId          String    @db.Uuid
  affiliateNumber String
  validFrom       DateTime  @db.Date
  validTo         DateTime? @db.Date
  notes           String?
  primary         Boolean   @default(true)
  archivedAt      DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  patient  Patient            @relation(fields: [patientId], references: [id])
  plan     CoveragePlan       @relation(fields: [planId], references: [id])
  services PerformedService[]

  @@index([patientId])
}

model Agreement {
  id        String    @id @default(uuid(7)) @db.Uuid
  planId    String    @db.Uuid
  validFrom DateTime  @db.Date
  validTo   DateTime? @db.Date
  notes     String?
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  plan  CoveragePlan    @relation(fields: [planId], references: [id])
  items AgreementItem[]

  @@index([planId])
}

model AgreementItem {
  id                    String  @id @default(uuid(7)) @db.Uuid
  agreementId           String  @db.Uuid
  practiceId            String  @db.Uuid
  insurerAmount         Decimal @db.Decimal(14, 2)
  patientCopay          Decimal @db.Decimal(14, 2)
  requiresAuthorization Boolean @default(false)

  agreement Agreement @relation(fields: [agreementId], references: [id])
  practice  Practice  @relation(fields: [practiceId], references: [id])

  @@unique([agreementId, practiceId])
}

enum LiquidationStatus {
  DRAFT
  SUBMITTED
  PAID
  CANCELLED
}

enum LiquidationItemStatus {
  PENDING
  APPROVED
  DEBITED
  REJECTED
}

model Liquidation {
  id               String            @id @default(uuid(7)) @db.Uuid
  organizationId   String            @db.Uuid
  providerId       String            @db.Uuid
  periodFrom       DateTime          @db.Date
  periodTo         DateTime          @db.Date
  status           LiquidationStatus @default(DRAFT)
  createdById      String            @db.Uuid
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  submittedAt      DateTime?         @db.Timestamptz(3)
  paidAt           DateTime?         @db.Timestamptz(3)
  paidAmount       Decimal?          @db.Decimal(14, 2)
  paymentReference String?
  cancelledAt      DateTime?         @db.Timestamptz(3)
  cancelReason     String?

  organization Organization      @relation(fields: [organizationId], references: [id])
  provider     CoverageProvider  @relation(fields: [providerId], references: [id])
  createdBy    User              @relation(fields: [createdById], references: [id])
  items        LiquidationItem[]

  @@index([organizationId, createdAt])
}

model LiquidationItem {
  id             String                @id @default(uuid(7)) @db.Uuid
  liquidationId  String                @db.Uuid
  serviceId      String                @db.Uuid
  claimedAmount  Decimal               @db.Decimal(14, 2)
  status         LiquidationItemStatus @default(PENDING)
  approvedAmount Decimal?              @db.Decimal(14, 2)
  reason         String?
  active         Boolean               @default(true)

  liquidation Liquidation      @relation(fields: [liquidationId], references: [id])
  service     PerformedService @relation(fields: [serviceId], references: [id])

  @@index([liquidationId])
  @@index([serviceId])
}

enum ReminderStatus {
  PENDING
  SENT
  CONFIRMED
  CANCELLED
  FAILED
}

model Reminder {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @db.Uuid
  appointmentId  String         @db.Uuid
  patientId      String         @db.Uuid
  status         ReminderStatus @default(PENDING)
  phone          String?
  message        String
  failureReason  String?
  scheduledFor   DateTime       @db.Date
  sentAt         DateTime?      @db.Timestamptz(3)
  sentById       String?        @db.Uuid
  confirmedAt    DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  appointment  Appointment  @relation(fields: [appointmentId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])

  @@unique([appointmentId, scheduledFor])
  @@index([organizationId, scheduledFor])
}
