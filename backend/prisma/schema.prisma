generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  timezone  String   @default("America/Argentina/Buenos_Aires")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  branches Branch[]
  users    User[]
  patients Patient[]
}

model Branch {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  address        String?
  phone          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  users        UserBranch[]

  @@index([organizationId])
}

enum Role {
  ADMIN
  DENTIST
  RECEPTIONIST
}

model User {
  id                  String   @id @default(uuid(7)) @db.Uuid
  organizationId      String   @db.Uuid
  username            String
  displayName         String
  passwordHash        String
  active              Boolean  @default(true)
  mustChangePassword  Boolean  @default(false)
  onboardingCompleted Boolean  @default(false)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)

  organization        Organization         @relation(fields: [organizationId], references: [id])
  roles               UserRole[]
  branches            UserBranch[]
  sessions            Session[]
  professionalProfile ProfessionalProfile?

  @@unique([organizationId, username])
  @@index([organizationId])
}

model UserRole {
  userId String @db.Uuid
  role   Role

  user User @relation(fields: [userId], references: [id])

  @@id([userId, role])
}

model UserBranch {
  userId   String @db.Uuid
  branchId String @db.Uuid

  user   User   @relation(fields: [userId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@id([userId, branchId])
  @@index([branchId])
}

model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  tokenHash  String    @unique
  userId     String    @db.Uuid
  csrfToken  String
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  ipAddress  String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model ProfessionalProfile {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @unique @db.Uuid
  licenseNumber String
  specialty     String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])
}

model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String?  @db.Uuid
  actorUserId    String?  @db.Uuid
  action         String
  entityType     String
  entityId       String?
  branchId       String?  @db.Uuid
  metadata       Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([actorUserId])
  @@index([entityType, entityId])
}

enum DocumentType {
  DNI
  LE
  LC
  PASAPORTE
  OTRO
}

model Patient {
  id               String       @id @default(uuid(7)) @db.Uuid
  organizationId   String       @db.Uuid
  firstName        String
  lastName         String
  documentType     DocumentType @default(DNI)
  documentNumber   String?
  birthDate        DateTime?    @db.Date
  phone            String?
  email            String?
  address          String?
  emergencyContact String?
  searchText       String
  archivedAt       DateTime?    @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, documentType, documentNumber])
  @@index([organizationId, archivedAt])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "Patient_searchText_trgm_idx")
}
