{
  "name": "sgo-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:new": "prisma migrate dev --create-only && npm run comments:fix",
    "db:deploy": "prisma migrate deploy",
    "prelint": "npm run db:generate",
    "lint": "eslint .",
    "pretypecheck": "npm run db:generate",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run db:generate",
    "test": "vitest run",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "openapi:check": "tsx scripts/export-openapi.ts --check",
    "comments:check": "node ../infra/checks/no-comments.mjs",
    "comments:fix": "node ../infra/checks/no-comments.mjs --fix",
    "unused": "knip",
    "duplicates": "jscpd --config ../.jscpd.json ../backend/src ../frontend/src"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.4",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "prisma": "7.10.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@emnapi/wasi-threads": "1.2.3",
    "@eslint/js": "10.0.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "eslint": "10.11.0",
    "jscpd": "5.4.0",
    "knip": "6.39.0",
    "pg": "8.23.0",
    "pino-pretty": "13.1.3",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2",
    "yaml": "2.9.1"
  }
}
