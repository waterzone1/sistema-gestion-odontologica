# copiar a .env y ajustar. nunca commitear el .env real

# postgres (lo usa docker compose y el backend cuando corre fuera de docker)
POSTGRES_USER=sgo
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=sgo
POSTGRES_PORT=5432

# backend corriendo en tu maquina (npm run dev). dentro de compose se arma solo
DATABASE_URL=postgresql://sgo:cambiar_esta_clave@localhost:5432/sgo

NODE_ENV=development
LOG_LEVEL=info

# https del proxy. en local caddy usa su propia CA interna
# SITE_ADDRESS es el nombre con el que se accede (localhost, o el host/ip del servidor en la lan)
SITE_ADDRESS=localhost
# direccion completa con la que se abre la app (con puerto si no es el 443)
PUBLIC_ORIGIN=https://localhost
HTTPS_PORT=443
HTTP_PORT=80
